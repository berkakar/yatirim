[Unit]
Description=Değerleme & Ucuzluk Skoru - NYSE servisi (NASDAQ 100 servisinden 1,5 saat sonra)

[Timer]
# Piyasa servisleri Yahoo Finance tarafından engellenmemek için farklı saatlerde çalışır.
OnCalendar=Mon..Fri *-*-* 18:45:00 America/New_York
Unit=yatirim-job@valuation-nyse.service
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
