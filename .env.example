# Mevcut Streamlit uygulamasi icin (bazi standalone script'ler bunlari os.environ'dan okuyor)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_API_DATA_URL=https://data.alpaca.markets

TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=

# Postgres (api/worker/beat servisleri icin)
POSTGRES_USER=yatirim
POSTGRES_PASSWORD=yatirim
POSTGRES_DB=yatirim
DATABASE_URL=postgresql://yatirim:yatirim@db:5432/yatirim

# Redis (cache + celery broker + ingestor)
REDIS_URL=redis://redis:6379/0
